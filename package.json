{
  "name": "team-calendar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "echo No tests yet - added in T03",
    "test:int": "echo No integration tests yet - added in T03",
    "test:e2e": "echo No e2e tests yet - added in T03",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "lefthook install",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "18.0.10",
    "lefthook": "2.2.2",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.24.0"
}
