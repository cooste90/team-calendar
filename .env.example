# Copy this file to .env and adjust. The defaults work for local development.
# Every variable is checked at startup by src/lib/env.ts.

# Postgres from docker-compose.yml: the dev database and the test database.
DATABASE_URL=postgresql://westcal:westcal@localhost:5432/westcal
DATABASE_URL_TEST=postgresql://westcal:westcal@localhost:5433/westcal_test

# Better Auth. The secret must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
BETTER_AUTH_URL=http://localhost:3000

# SSO group whose members become calendar admins.
ADMIN_GROUP_NAME=CALENDAR_ADMIN

# Comma-separated employee numbers that get the super admin role.
SUPER_ADMIN_EMPLOYEE_NUMBERS=100001

# Shows the fake sign-in page for local development. Always off in production.
DEV_SIGN_IN_ENABLED=true

# Corporate SSO. Leave these commented out until you connect the real identity
# provider (see docs/PORTING-SSO.md).
# SSO_DISCOVERY_URL=https://sso.example.com/.well-known/openid-configuration
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_SCOPES="openid profile email"

# Time zone used for "today" and the grid.
APP_TIME_ZONE=Europe/London

# Uncomment to print every SQL query in the terminal.
# PRISMA_LOG=query
